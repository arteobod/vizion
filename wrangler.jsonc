{
  "name": "vizion",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2024-12-30",
  "kv_namespaces": [
    {
      "binding": "VIZON_KV",
      "id": "d24307dc75364e7986bac03496378a2e"
    },
    {
      // OpenNext incremental cache (ISR). Holds pre-rendered page payloads so
      // Cloudflare serves the public pages from the edge instead of rendering
      // each request in the Worker. Separate namespace from VIZON_KV so cache
      // entries never collide with the site's own data keys. See
      // open-next.config.ts for the wiring.
      "binding": "NEXT_INC_CACHE_KV",
      "id": "2bf27f15367e4ff6997654c4b3fe1fcf"
    }
  ],

  // The revalidation queue re-requests a stale route through this same Worker,
  // so the Worker needs a way to call itself. See open-next.config.ts — without
  // this binding the queue cannot run and ISR silently stops refreshing.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vizion"
    }
  ]

  // ADMIN_USERNAME, ADMIN_PASSWORD_HASH and JWT_SECRET used to live here in a
  // "vars" block. This file is committed to a public repository, so that put the
  // admin JWT signing key where anyone could read it and sign themselves a
  // valid admin cookie. They are now Worker secrets, set out of band:
  //
  //   npx wrangler secret put JWT_SECRET
  //   npx wrangler secret put ADMIN_USERNAME
  //   npx wrangler secret put ADMIN_PASSWORD_HASH
  //
  // Secrets are write-only — Cloudflare will not read them back — and they
  // survive redeploys. Do not reintroduce any of them as "vars": a plain var
  // with the same name shadows the secret and republishes the value.
  //
  // Dev reads its own copies from .env.local, which is gitignored, and the two
  // sets are deliberately different values.
}
