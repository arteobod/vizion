{
  "name": "vizion",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2024-12-30",
  "kv_namespaces": [
    {
      "binding": "VIZON_KV",
      "id": "d24307dc75364e7986bac03496378a2e"
    }
  ]

  // ADMIN_USERNAME, ADMIN_PASSWORD_HASH and JWT_SECRET used to live here in a
  // "vars" block. This file is committed to a public repository, so that put the
  // admin JWT signing key where anyone could read it and sign themselves a
  // valid admin cookie. They are now Worker secrets, set out of band:
  //
  //   npx wrangler secret put JWT_SECRET
  //   npx wrangler secret put ADMIN_USERNAME
  //   npx wrangler secret put ADMIN_PASSWORD_HASH
  //
  // Secrets are write-only — Cloudflare will not read them back — and they
  // survive redeploys. Do not reintroduce any of them as "vars": a plain var
  // with the same name shadows the secret and republishes the value.
  //
  // Dev reads its own copies from .env.local, which is gitignored, and the two
  // sets are deliberately different values.
}
