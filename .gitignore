# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files. Broad on purpose: the previous rule was `.env*.local`, which left a
# bare `.env` and `.env.production` trackable. This repository is public and has
# already leaked credentials once through a committed config file, so the default
# is ignore-everything and name the samples explicitly.
.env*
!.env.example
!.env.sample

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Uploads (user-generated content)
/public/uploads/*
!/public/uploads/.gitkeep

# Cloudflare / OpenNext build artifacts
/.open-next/
/.wrangler/

# Claude Code local settings
/.claude/

# Lock files for skills
skills-lock.json
.gstack/
